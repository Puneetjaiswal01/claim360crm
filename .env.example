# Public Supabase API URL and publishable key (never a service-role key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional isolated workspace for next dev on localhost; disabled in production.
NEXT_PUBLIC_LOCAL_DEV=false
LOCAL_DEV_AUTH=false
LOCAL_DEV_ADMIN_EMAIL=
# Format: random salt + colon + 64-byte scrypt hash encoded as hex.
LOCAL_DEV_ADMIN_PASSWORD_HASH=
LOCAL_DEV_SESSION_SECRET=

# Stitch design tooling only; never use NEXT_PUBLIC_ for the API key.
STITCH_API_KEY=
# Optional: reuse a project instead of creating one on the first generation.
STITCH_PROJECT_ID=
